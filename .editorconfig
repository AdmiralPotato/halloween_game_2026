root = true

[*]
charset = utf-8
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# GDScript formatting (Godot standard prefers tabs)
[*.gd]
indent_style = tab
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2
